+/*
+ * v18 diagnostic probe for retail D3D wait helper 0x00191440.
+ *
+ * v17 reaches the D3D shutdown chain and spends the watchdog interval without
+ * further kernel calls. Retail 0x001914F0..0x001914F8 is a tight memory poll
+ * waiting for the guest-visible pushbuffer progress value to move. This probe
+ * is deliberately read-only: it snapshots the D3D global/device state and the
+ * progress pointer/value represented by the retail registers.
+ */
+void jsrf_d3d_wait_probe(uint32_t va)
+{
+    enum { SLOT_COUNT = 8 };
+    static uint32_t sites[SLOT_COUNT];
+    static uint64_t hits[SLOT_COUNT];
+    static int count;
+    uint32_t device = 0;
+    uint32_t device_pos = 0;
+    uint32_t device_progress_ptr = 0;
+    uint32_t device_progress_value = 0;
+    uint32_t progress_ptr = g_edx;
+    uint32_t progress_value = 0;
+    int have_device = 0;
+    int have_progress = 0;
+    int i;
+
+    for (i = 0; i < count; ++i) {
+        if (sites[i] == va) {
+            break;
+        }
+    }
+    if (i == count) {
+        if (count == SLOT_COUNT) {
+            return;
+        }
+        sites[count] = va;
+        hits[count] = 0;
+        ++count;
+    }
+
+    ++hits[i];
+    if (hits[i] > 4 && (hits[i] & (hits[i] - 1)) != 0) {
+        return;
+    }
+
+    if (jsrf_guest_read_u32(0x0019DCE0u, &device) &&
+        device >= 0x00001000u && device <= 0x03FFDBBCu) {
+        have_device =
+            jsrf_guest_read_u32(device + 0x30u, &device_pos) &&
+            jsrf_guest_read_u32(device + 0x34u, &device_progress_ptr);
+        if (have_device) {
+            jsrf_guest_read_u32(device_progress_ptr, &device_progress_value);
+        }
+    }
+
+    have_progress = jsrf_guest_read_u32(progress_ptr, &progress_value);
+
+    fprintf(stderr,
+            "[D3DWAIT] va=%08X hit=%llu esp=%08X eax=%08X ecx=%08X "
+            "edx=%08X ebx=%08X esi=%08X edi=%08X "
+            "device=%08X device_pos=%08X device_progress_ptr=%08X "
+            "device_progress_value=%08X progress_ptr=%08X progress_value=%08X",
+            va, (unsigned long long)hits[i], g_esp, g_eax, g_ecx, g_edx,
+            g_ebx, g_esi, g_edi, device, device_pos, device_progress_ptr,
+            device_progress_value, progress_ptr, progress_value);
+    if (!have_device) {
+        fputs(" device_unreadable=1", stderr);
+    }
+    if (!have_progress) {
+        fputs(" progress_unreadable=1", stderr);
+    }
+    fputc('\n', stderr);
+    fflush(stderr);
+}
