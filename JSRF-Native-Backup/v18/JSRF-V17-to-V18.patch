+def instrument_jsrf_d3d_wait_probe(gen_dir: str | Path) -> None:
+    """Inject read-only probes into retail D3D pushbuffer wait 0x00191440.
+
+    v17 advances far beyond the allocator failure and its watchdog stack lands
+    in 0x00191440 through the retail D3D shutdown chain.  The last 60-second
+    interval contains no kernel calls, matching the pure memory polling loop at
+    0x001914F0.  Observe only measured retail block labels so the next run can
+    prove whether the guest-visible progress/GET value is static.
+    """
+    import re
+
+    gen_dir = Path(gen_dir)
+    signature = "void sub_00191440(void)"
+    declaration = "extern void jsrf_d3d_wait_probe(uint32_t va);"
+    found_function = False
+    injected = set()
+
+    for source in sorted(gen_dir.glob("recomp_*.c")):
+        text = source.read_text(encoding="utf-8", errors="replace")
+        start = text.find(signature)
+        if start < 0:
+            continue
+        found_function = True
+        next_function = text.find("\n/**", start + len(signature))
+        end = len(text) if next_function < 0 else next_function
+        body = text[start:end]
+
+        if "jsrf_d3d_wait_probe(" in body:
+            return
+
+        for va in JSRF_D3D_WAIT_PROBE_VAS:
+            label_re = re.compile(rf"(?mi)^(?P<label>loc_{va:08X}:\s*;?\s*)$")
+            replacement = rf"\g<label>\n    jsrf_d3d_wait_probe(0x{va:08X}u);"
+            body, count = label_re.subn(replacement, body, count=1)
+            if count:
+                injected.add(va)
+
+        missing = set(JSRF_D3D_WAIT_PROBE_VAS) - injected
+        if missing:
+            rendered = ", ".join(f"0x{va:08X}" for va in sorted(missing))
+            raise RuntimeError(
+                "Generated sub_00191440 is missing retail D3D wait probe label(s): "
+                + rendered
+            )
+
+        if declaration not in text[:start]:
+            body = declaration + "\n" + body
+        text = text[:start] + body + text[end:]
+        source.write_text(text, encoding="utf-8")
+        return
+
+    if not found_function:
+        raise RuntimeError("Generated sub_00191440 was not found for v18 D3D wait probing")
 
 
