+    def test_v18_d3d_wait_probe_instruments_only_retail_pushbuffer_wait_landmarks(self):
+        import scripts.jsrf_xboxrecomp as driver
+        instrument = getattr(driver, "instrument_jsrf_d3d_wait_probe", None)
+        self.assertIsNotNone(
+            instrument,
+            "v18 must add focused basic-block probes to retail D3D wait function 0x00191440",
+        )
+        generated = r"""
+void sub_00191440(void)
+{
+loc_00191440: ;
+    eax = 1;
+loc_001914F0: ;
+    eax = 2;
+loc_001914FC: ;
+    eax = 3;
+loc_00191510: ;
+    eax = 4;
+loc_0019151F: ;
+    eax = 5;
+}
+/** next */
+void sub_00192000(void)
+{
+loc_001914F0: ;
+}
+"""
+        with tempfile.TemporaryDirectory() as td:
+            gen_dir = Path(td)
+            source = gen_dir / "recomp_0000.c"
+            source.write_text(generated, encoding="utf-8")
+            instrument(gen_dir)
+            once = source.read_text(encoding="utf-8")
+            instrument(gen_dir)
+            twice = source.read_text(encoding="utf-8")
+
+        self.assertEqual(once, twice, "D3D wait probe injection must be idempotent")
+        self.assertEqual(once.count("extern void jsrf_d3d_wait_probe(uint32_t va);"), 1)
+        for va in driver.JSRF_D3D_WAIT_PROBE_VAS:
+            self.assertEqual(
+                once.count(f"jsrf_d3d_wait_probe(0x{va:08X}u);"),
+                1,
+                f"missing focused D3D wait probe at 0x{va:08X}",
+            )
+        unrelated = once.split("void sub_00192000(void)", 1)[1]
+        self.assertNotIn("jsrf_d3d_wait_probe", unrelated)
