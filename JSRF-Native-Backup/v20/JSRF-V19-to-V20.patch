+    def test_v20_trace_covers_game_main_startup_failure_chain(self):
+        root = Path(__file__).resolve().parents[1]
+        path = root / "recomp" / "jsrf_trace_functions.json"
+        starts = {
+            int(value, 16) if isinstance(value, str) else int(value)
+            for value in json.loads(path.read_text(encoding="utf-8"))
+        }
+        # v19 clears the heap and D3D fence stalls, then the retail game main
+        # returns and XAPI reboots.  The application stores sub_0005F350's
+        # startup status at +0x10; both setup and the main loop bail on a
+        # negative value.  Trace the complete direct-call chain so one Windows
+        # run identifies the first failing subsystem without changing guest state.
+        self.assertTrue({
+            0x0006F9E0,  # retail game main
+            0x00012210,  # main application constructor
+            0x0005F350,  # startup status producer
+            0x00012C10,  # setup method that checks +0x10
+            0x00013F80,  # run loop that checks +0x10
+            0x0014CAA0, 0x001BB690, 0x0014CAF0, 0x001BB750,
+            0x0005F2C0, 0x0005F250, 0x00156DF0,
+            0x001680D0, 0x00116EC0,
+            0x0014ADA3, 0x00147532,
+        }.issubset(starts))
