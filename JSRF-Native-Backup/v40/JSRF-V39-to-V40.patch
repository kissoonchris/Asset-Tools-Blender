+import json
+from pathlib import Path
+
+import pytest
+
+
+def test_v40_pins_read_mark_default_whole_retail_function():
+    from scripts.jsrf_xboxrecomp import JSRF_RETAIL_FUNCTION_BOUNDARIES
+
+    bounds = {item["start"]: item for item in JSRF_RETAIL_FUNCTION_BOUNDARIES}
+    method = bounds[0x0002D080]
+
+    # v39 Windows runtime: generic CFG recovery exposes 0x2D1F8 as an
+    # unresolved indirect destination while executing the retail routine that
+    # starts at 0x2D080. The owning call then returns exactly 0x100 bytes below
+    # its expected guest ESP. Independent JSRF symbol data identifies 0x2D080
+    # as readMarkDefault and 0x2DBE0 as the next real function start.
+    assert method["end"] == 0x0002DBE0
+
+
+def test_v40_boundary_pinner_absorbs_2d1f8_internal_case(tmp_path):
+    from scripts.jsrf_xboxrecomp import pin_jsrf_function_boundaries
+
+    functions = [
+        {
+            "start": "0x0002D000",
+            "end": "0x0002D1F8",
+            "size": 0x1F8,
+            "name": "sub_0002D000",
+            "section": ".text",
+            "called_by": [],
+        },
+        {
+            "start": "0x0002D080",
+            "end": "0x0002D1F8",
+            "size": 0x178,
+            "name": "sub_0002D080",
+            "section": ".text",
+            "called_by": [],
+        },
+        {
+            "start": "0x0002D1F8",
+            "end": "0x0002D260",
+            "size": 0x68,
+            "name": "sub_0002D1F8",
+            "section": ".text",
+            "called_by": [],
+        },
+        {
+            "start": "0x0002D260",
+            "end": "0x0002DBE0",
+            "size": 0x980,
+            "name": "sub_0002D260",
+            "section": ".text",
+            "called_by": [],
+        },
+        {
+            "start": "0x0002DBE0",
+            "end": "0x0002E170",
+            "size": 0x590,
+            "name": "sub_0002DBE0",
+            "section": ".text",
+            "called_by": [],
+        },
+    ]
+    path = tmp_path / "functions.json"
+    path.write_text(json.dumps(functions), encoding="utf-8")
+
+    pin_jsrf_function_boundaries(path)
+    pinned = json.loads(path.read_text(encoding="utf-8"))
+    by_start = {int(item["start"], 16): item for item in pinned}
+
+    assert int(by_start[0x0002D080]["end"], 16) == 0x0002DBE0
+    assert by_start[0x0002D080]["size"] == 0xB60
+    assert 0x0002D1F8 not in by_start
+    assert 0x0002D260 not in by_start
+    assert int(by_start[0x0002D000]["end"], 16) == 0x0002D080
+    # The adjacent v39 correction must remain a separate function.
+    assert int(by_start[0x0002DBE0]["end"], 16) == 0x0002E170
+
+
+def _write_contract_fixture(path: Path, *, include_internal_case: bool) -> None:
+    internal_case = "loc_0002D1F8:;\n" if include_internal_case else ""
+    path.write_text(
+        "void sub_00160080(void) {\n"
+        "esp += 16; return; /* ret 12 */\n"
+        "esp += 16; return; /* ret 12 */\n"
+        "esp += 16; return; /* ret 12 */\n"
+        "}\n/** next */\n"
+        "void sub_00178A00(void) { esp += 28; return; /* ret 24 */ }\n"
+        "/** next */\n"
+        "void sub_00011070(void) { esp += 4; return; /* ret */ }\n"
+        "/** next */\n"
+        "void sub_00025040(void) {\n"
+        + "\n".join(["esp += 4; return; /* ret */"] * 9)
+        + "\n}\n/** next */\n"
+        "void sub_0007E180(void) {\n"
+        + "\n".join(["esp += 4; return; /* ret */"] * 3)
+        + "\n}\n/** next */\n"
+        "void sub_000304F0(void) {\n"
+        + "\n".join(["esp += 4; return; /* ret */"] * 2)
+        + "\n}\n/** next */\n"
+        "void sub_0002D080(void) {\n"
+        + internal_case
+        + "esp += 4; return; /* ret */\n"
+        "}\n/** next */\n"
+        "void sub_0002DBE0(void) {\n"
+        + "\n".join(["esp += 4; return; /* ret */"] * 8)
+        + "\n}\n/** next */\n",
+        encoding="utf-8",
+    )
+
+
+def test_v40_generated_contract_rejects_missing_internal_2d1f8_case(tmp_path):
+    from scripts.jsrf_xboxrecomp import verify_jsrf_generated_contracts
+
+    _write_contract_fixture(tmp_path / "recomp_0000.c", include_internal_case=False)
+    with pytest.raises(RuntimeError, match="0002D1F8"):
+        verify_jsrf_generated_contracts(
+            tmp_path,
+            require_v35_low_text=True,
+            require_v36_vtable=True,
+            require_v37_switch=True,
+            require_v39_title_switch=True,
+            require_v40_mark_default=True,
+        )
+
+
+def test_v40_generated_contract_accepts_2d1f8_inside_read_mark_default(tmp_path):
+    from scripts.jsrf_xboxrecomp import verify_jsrf_generated_contracts
+
+    _write_contract_fixture(tmp_path / "recomp_0000.c", include_internal_case=True)
+    verify_jsrf_generated_contracts(
+        tmp_path,
+        require_v35_low_text=True,
+        require_v36_vtable=True,
+        require_v37_switch=True,
+        require_v39_title_switch=True,
+        require_v40_mark_default=True,
+    )
