+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+EXPECTED = {
+    0x0013CE30: 0x0013D080,
+    0x0013D080: 0x0013D1A0,
+    0x0013D1A0: 0x0013D210,
+    0x0013D210: 0x0013D250,
+    0x0013D250: 0x0013D300,
+    0x0013D300: 0x0013D470,
+    0x0013D470: 0x0013D4E0,
+}
+
+
+def test_v61_pins_complete_retail_adxt_state_machine_cluster():
+    from scripts.jsrf_xboxrecomp import JSRF_RETAIL_FUNCTION_BOUNDARIES
+
+    actual = {
+        item["start"]: item["end"]
+        for item in JSRF_RETAIL_FUNCTION_BOUNDARIES
+        if item["start"] in EXPECTED
+    }
+    assert actual == EXPECTED
+
+
+def test_v61_boundary_pinner_removes_internal_false_splits(tmp_path):
+    from scripts.jsrf_xboxrecomp import pin_jsrf_function_boundaries
+
+    # Model the failure observed in generated JSRF code: the watchdog body is
+    # split at internal 0x13D3C6/0x13D3F5 blocks and the mode-2 updater is not
+    # represented as its own complete function.
+    functions = [
+        {
+            "start": "0x0013CE30", "end": "0x0013D1A0", "size": 0x370,
+            "name": "sub_0013CE30", "section": ".text", "confidence": 0.5,
+            "num_instructions": 0, "has_prologue": False,
+            "calls_to": [], "called_by": [],
+        },
+        {
+            "start": "0x0013D300", "end": "0x0013D3C6", "size": 0xC6,
+            "name": "sub_0013D300", "section": ".text", "confidence": 0.5,
+            "num_instructions": 0, "has_prologue": False,
+            "calls_to": [], "called_by": [],
+        },
+        {
+            "start": "0x0013D3C6", "end": "0x0013D3F5", "size": 0x2F,
+            "name": "sub_0013D3C6", "section": ".text", "confidence": 0.5,
+            "num_instructions": 0, "has_prologue": False,
+            "calls_to": [], "called_by": [],
+        },
+        {
+            "start": "0x0013D3F5", "end": "0x0013D470", "size": 0x7B,
+            "name": "sub_0013D3F5", "section": ".text", "confidence": 0.5,
+            "num_instructions": 0, "has_prologue": False,
+            "calls_to": [], "called_by": [],
+        },
+    ]
+    path = tmp_path / "functions.json"
+    path.write_text(json.dumps(functions), encoding="utf-8")
+
+    pin_jsrf_function_boundaries(path)
+    out = json.loads(path.read_text(encoding="utf-8"))
+    by_start = {int(item["start"], 16): item for item in out}
+
+    for start, end in EXPECTED.items():
+        assert start in by_start
+        assert int(by_start[start]["end"], 16) == end
+        assert by_start[start]["detection_method"] == "jsrf_retail_boundary"
+
+    assert 0x0013D3C6 not in by_start
+    assert 0x0013D3F5 not in by_start
+
+
+def test_v61_seeds_every_retail_adxt_state_machine_entry():
+    seeds = json.loads((ROOT / "recomp" / "jsrf_runtime_seeds.json").read_text(encoding="utf-8"))
+    starts = {int(item["start"], 16) for item in seeds}
+    assert set(EXPECTED).issubset(starts)
+
+
+def test_v61_banner_is_current():
+    main_c = (ROOT / "recomp" / "src" / "main.c").read_text(encoding="utf-8")
+    assert "JSRF Native v61" in main_c
