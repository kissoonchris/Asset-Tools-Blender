+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+BUILD = ROOT / "scripts" / "Build-JSRF-XboxRecomp.ps1"
+
+# Retail DSOUND sub_001A52F7 selects descriptor index 12 when the object was
+# constructed with type 1 (sub_001A52AF stores that at object+8). The v33
+# Windows run shows descriptor 12's 0xC000-byte allocation at 0x803C0000.
+JSRF_GP_DESCRIPTOR12_BASE = 0x803C0000
+JSRF_GP_DOORBELL = JSRF_GP_DESCRIPTOR12_BASE + 0x810
+
+
+def test_windows_runner_targets_the_selected_gp_descriptor_mailbox():
+    text = BUILD.read_text(encoding="utf-8")
+
+    assert f'0x{JSRF_GP_DOORBELL:08X}' in text, (
+        "JSRF's GP command sender uses descriptor 12; the DSP acknowledgement "
+        "must poll descriptor12+0x810"
+    )
+    assert "0x8037B810" not in text, (
+        "0x8037B810 belongs to descriptor 0, which the retail command object "
+        "does not select"
+    )
