+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_v38_enables_real_guest_framebuffer_and_pushbuffer_execution_by_default():
+    build = (ROOT / "scripts" / "Build-JSRF-XboxRecomp.ps1").read_text(encoding="utf-8")
+
+    # v37 reaches retail AvSetDisplayMode and then stays alive in the game loop,
+    # but xboxrecomp's real guest framebuffer window and pushbuffer executor are
+    # opt-in environment features. The easy test must turn them on so the user's
+    # next run can show pixels produced from JSRF's own NV2A command stream.
+    assert '$env:RECOMP_FB_WINDOW = "1"' in build
+    assert '$env:RECOMP_PB_EXEC = "1"' in build
+
+    # Keep the survey/verbose diagnostics on for the first visual bring-up. If
+    # the window is black, the log must say what JSRF actually submitted rather
+    # than forcing us to guess which NV2A method is missing.
+    assert '$env:RECOMP_PB_SCAN = "1"' in build
+    assert '$env:RECOMP_PB_EXEC_VERBOSE = "1"' in build
+    assert '$env:RECOMP_PB_UNHANDLED_ALL = "1"' in build
+
+    # Never enable the synthetic raster test in the user's package: any pixels
+    # shown must come from the retail title's own framebuffer/pushbuffer.
+    assert '$env:RECOMP_RASTER_TEST' not in build
