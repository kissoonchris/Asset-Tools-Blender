+std::vector<StageCollisionCandidate> findStageCollisionCandidates(
+    const StageRuntime& stage,
+    const Aabb& query,
+    std::uint32_t surfaceMask) {
+    std::vector<StageCollisionCandidate> out;
+    const std::uint16_t lowMask = static_cast<std::uint16_t>(surfaceMask & 0xffffu);
+    if (lowMask == 0u) return out;
+
+    for (std::size_t modelIndex = 0; modelIndex < stage.collisionModels.size(); ++modelIndex) {
+        const auto& model = stage.collisionModels[modelIndex];
+        for (std::size_t triangleIndex = 0; triangleIndex < model.triangles.size(); ++triangleIndex) {
+            const auto& tri = model.triangles[triangleIndex];
+            if ((tri.surfaceProperties & lowMask) == 0u) continue;
+            if (tri.index0 >= model.worldVertices.size() ||
+                tri.index1 >= model.worldVertices.size() ||
+                tri.index2 >= model.worldVertices.size()) {
+                continue;
+            }
+            const Vec3 a = model.worldVertices[tri.index0];
+            const Vec3 b = model.worldVertices[tri.index1];
+            const Vec3 c = model.worldVertices[tri.index2];
+            const Aabb triBounds{
+                {std::min({a.x, b.x, c.x}), std::min({a.y, b.y, c.y}), std::min({a.z, b.z, c.z})},
+                {std::max({a.x, b.x, c.x}), std::max({a.y, b.y, c.y}), std::max({a.z, b.z, c.z})}};
+            if (overlaps(query, triBounds)) out.push_back({modelIndex, triangleIndex});
+        }
+    }
+    return out;
+}
+
+std::optional<StageSegmentContact> findClosestStageSegmentContact(
+    const StageRuntime& stage,
+    std::span<const StageCollisionCandidate> candidates,
+    Vec3 start,
+    Vec3 end,
+    std::uint32_t surfaceMask) {
+    const Vec3 delta = sub(end, start);
+    const float segmentLength2 = lengthSquared(delta);
+    if (segmentLength2 <= 1.0e-20f) return std::nullopt;
+
+    const std::uint16_t lowMask = static_cast<std::uint16_t>(surfaceMask & 0xffffu);
+    if (lowMask == 0u) return std::nullopt;
+
+    const Aabb segmentBounds = normalizedAabb(start, end);
+    std::optional<StageSegmentContact> best;
+    float bestDistance = std::numeric_limits<float>::infinity();
+
+    for (const auto candidate : candidates) {
+        if (candidate.modelIndex >= stage.collisionModels.size()) continue;
+        const auto& model = stage.collisionModels[candidate.modelIndex];
+        if (candidate.triangleIndex >= model.triangles.size()) continue;
+        const auto& tri = model.triangles[candidate.triangleIndex];
+        if ((tri.surfaceProperties & lowMask) == 0u) continue;
+        if (tri.index0 >= model.worldVertices.size() ||
+            tri.index1 >= model.worldVertices.size() ||
+            tri.index2 >= model.worldVertices.size()) {
+            continue;
+        }
+
+        const Vec3 a = model.worldVertices[tri.index0];
+        const Vec3 b = model.worldVertices[tri.index1];
+        const Vec3 c = model.worldVertices[tri.index2];
+        const Aabb triBounds{
+            {std::min({a.x, b.x, c.x}), std::min({a.y, b.y, c.y}), std::min({a.z, b.z, c.z})},
+            {std::max({a.x, b.x, c.x}), std::max({a.y, b.y, c.y}), std::max({a.z, b.z, c.z})}};
+        if (!overlaps(segmentBounds, triBounds)) continue;
+
+        // Retail 0x18260 is one-sided: only a segment travelling into the
+        // triangle's authored front face can produce a static-stage contact.
+        const Vec3 unnormalizedNormal{
+            (b.y - a.y) * (c.z - a.z) - (b.z - a.z) * (c.y - a.y),
+            (b.z - a.z) * (c.x - a.x) - (b.x - a.x) * (c.z - a.z),
+            (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)};
+        const float normalLength2 = lengthSquared(unnormalizedNormal);
+        if (normalLength2 <= 1.0e-20f) continue;
+        const float denom = dot(unnormalizedNormal, delta);
+        if (denom >= 0.0f) continue;
+
+        const float t = dot(unnormalizedNormal, sub(a, start)) / denom;
+        if (t < 0.0f || t > 1.0f) continue;
+        const Vec3 point = add(start, mul(delta, t));
+
+        // Inclusive point-in-triangle test using the triangle's own winding.
+        auto edgeSide = [&](Vec3 p0, Vec3 p1) {
+            const Vec3 e = sub(p1, p0);
+            const Vec3 q = sub(point, p0);
+            const Vec3 cross{
+                e.y * q.z - e.z * q.y,
+                e.z * q.x - e.x * q.z,
+                e.x * q.y - e.y * q.x};
+            return dot(cross, unnormalizedNormal);
+        };
+        constexpr float kInsideTolerance = -1.0e-5f;
+        if (edgeSide(a, b) < kInsideTolerance ||
+            edgeSide(b, c) < kInsideTolerance ||
+            edgeSide(c, a) < kInsideTolerance) {
+            continue;
+        }
+
+        const float distance = std::sqrt(segmentLength2) * t;
+        if (distance >= bestDistance) continue;
+        bestDistance = distance;
+        best = StageSegmentContact{
+            candidate.modelIndex,
+            candidate.triangleIndex,
+            point,
+            normalized(unnormalizedNormal),
+            tri.surfaceProperties,
+            t,
+            distance};
+    }
+    return best;
+}
+
 std::optional<GrindAttachPoint> findNearestGrindSegment(const StageRuntime& stage, const Aabb& query, Vec3 point) {
     const auto candidates = findGrindCandidates(stage, query);
     std::optional<GrindAttachPoint> best;
