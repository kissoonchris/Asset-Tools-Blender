     float distanceSquared{};
 };
 
+// Stable references into StageRuntime's decoded static collision data.  The retail
+// collision manager expands these into cached 0x108-byte records; keeping model/
+// triangle indices here preserves the same authored triangle without baking in
+// still-unknown cache fields.
+struct StageCollisionCandidate {
+    std::size_t modelIndex{};
+    std::size_t triangleIndex{};
+};
+
+struct StageSegmentContact {
+    std::size_t modelIndex{};
+    std::size_t triangleIndex{};
+    Vec3 point{};
+    Vec3 normal{};
+    std::uint16_t surfaceProperties{};
+    float segmentT{};
+    float distance{};
+};
+
 [[nodiscard]] StageRuntime parseStageRuntime(std::span<const std::byte> bytes);
 [[nodiscard]] bool overlaps(const Aabb& a, const Aabb& b) noexcept;
 [[nodiscard]] std::vector<std::size_t> findGrindCandidates(const StageRuntime& stage, const Aabb& query);
+[[nodiscard]] std::vector<StageCollisionCandidate> findStageCollisionCandidates(
+    const StageRuntime& stage,
+    const Aabb& query,
+    std::uint32_t surfaceMask);
+[[nodiscard]] std::optional<StageSegmentContact> findClosestStageSegmentContact(
+    const StageRuntime& stage,
+    std::span<const StageCollisionCandidate> candidates,
+    Vec3 start,
+    Vec3 end,
+    std::uint32_t surfaceMask);
 [[nodiscard]] std::optional<GrindAttachPoint> findNearestGrindSegment(
     const StageRuntime& stage,
     const Aabb& query,
