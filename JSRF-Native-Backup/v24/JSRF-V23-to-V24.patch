+def patch_xboxrecomp_repeated_string_compare_flags(toolkit_dir: str | Path) -> None:
+    """Track REP CMPS/SCAS word+dword flags in the pinned block lifter.
+
+    The pinned instruction lift already executes CMPSW/CMPSD/SCASW/SCASD and
+    stores the final equality result in ``_flags``.  Its block-level flag
+    tracker, however, only recognizes the byte spellings as flag producers.
+    A following SETcc/Jcc can therefore be rebuilt from an older instruction
+    instead of the repeated comparison.  JSRF's DirectSound QueryInterface at
+    retail 0x00168310 has exactly ``xor edx, edx; ...; repz cmpsd; sete dl``;
+    stale XOR flags make the first GUID appear to match unconditionally.
+
+    Do not change the comparison loop itself.  Make the tracker recognize the
+    same CMPS/SCAS widths that the pinned instruction lift already implements.
+    """
+    toolkit_dir = Path(toolkit_dir)
+    path = toolkit_dir / "tools" / "recomp" / "lifter.py"
+    if not path.is_file():
+        raise FileNotFoundError(f"xboxrecomp lifter was not found: {path}")
+
+    text = path.read_text(encoding="utf-8")
+    marker = "_REPE_COMPARE_FLAG_MNEMONICS = ("
+    if marker in text:
+        return
+
+    # Refuse to paper over an upstream shape change.  The pinned lifter must
+    # already have real wide CMPS/SCAS execution before flag tracking is safe.
+    if ('if "cmpsw" in m or "cmpsd" in m:' not in text
+            or 'if "scasw" in m or "scasd" in m:' not in text):
+        raise RuntimeError(
+            "Pinned xboxrecomp no longer contains the expected wide CMPS/SCAS lift"
+        )
+
+    old = '            # rep movsb/movsd = data copy, preserves flags\n            # repe cmpsb/repne scasb = comparison, sets flags\n            rest = curr.op_str.strip() if hasattr(curr, \'op_str\') else ""\n            raw_m = curr.mnemonic\n            if "cmpsb" in raw_m or "scasb" in raw_m:\n                last_flag_setter = raw_m\n                last_flag_ops = list(curr.operands)\n            elif "cmpsb" in rest or "scasb" in rest:\n                last_flag_setter = raw_m\n                last_flag_ops = list(curr.operands)\n            else:\n                pass  # rep movs/stos = data movement, flags preserved\n'
+    new = '            # rep movs/stos = data movement, preserves flags.  Every CMPS/SCAS\n            # width implemented by lift_instruction is a comparison and sets flags.\n            rest = curr.op_str.strip() if hasattr(curr, \'op_str\') else ""\n            raw_m = curr.mnemonic\n            _REPE_COMPARE_FLAG_MNEMONICS = (\n                "cmpsb", "cmpsw", "cmpsd",\n                "scasb", "scasw", "scasd",\n            )\n            if any(name in raw_m for name in _REPE_COMPARE_FLAG_MNEMONICS):\n                last_flag_setter = raw_m\n                last_flag_ops = list(curr.operands)\n            elif any(name in rest for name in _REPE_COMPARE_FLAG_MNEMONICS):\n                last_flag_setter = raw_m\n                last_flag_ops = list(curr.operands)\n            else:\n                pass  # rep movs/stos = data movement, flags preserved\n'
+
+    count = text.count(old)
+    if count != 1:
+        raise RuntimeError(
+            "Pinned xboxrecomp repeated-string flag patch no longer matches lifter.py "
+            f"(tracker occurrences={count})"
+        )
+    path.write_text(text.replace(old, new, 1), encoding="utf-8")
+
+
