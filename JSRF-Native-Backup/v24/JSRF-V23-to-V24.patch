index 0000000..1a0605a
--- /dev/null
+++ b/tests/test_v24_repeated_wide_string_flags.py
@@ -0,0 +1,63 @@
+from pathlib import Path
+
+
+def root() -> Path:
+    return Path(__file__).resolve().parents[1]
+
+
+def _pinned_tracker_fixture() -> str:
+    return '''\
+if "cmpsw" in m or "cmpsd" in m:
+    pass
+if "scasw" in m or "scasd" in m:
+    pass
+
+        elif curr.mnemonic.startswith("rep"):
+            # rep movsb/movsd = data copy, preserves flags
+            # repe cmpsb/repne scasb = comparison, sets flags
+            rest = curr.op_str.strip() if hasattr(curr, 'op_str') else ""
+            raw_m = curr.mnemonic
+            if "cmpsb" in raw_m or "scasb" in raw_m:
+                last_flag_setter = raw_m
+                last_flag_ops = list(curr.operands)
+            elif "cmpsb" in rest or "scasb" in rest:
+                last_flag_setter = raw_m
+                last_flag_ops = list(curr.operands)
+            else:
+                pass  # rep movs/stos = data movement, flags preserved
+'''
+
+
+def test_v24_patch_tracks_wide_repeated_string_comparisons(tmp_path):
+    from scripts.jsrf_xboxrecomp import patch_xboxrecomp_repeated_string_compare_flags
+
+    toolkit = tmp_path / "xboxrecomp"
+    lifter = toolkit / "tools" / "recomp" / "lifter.py"
+    lifter.parent.mkdir(parents=True)
+    lifter.write_text(_pinned_tracker_fixture(), encoding="utf-8")
+
+    patch_xboxrecomp_repeated_string_compare_flags(toolkit)
+    patched = lifter.read_text(encoding="utf-8")
+
+    # The wide forms already assign _flags in the pinned instruction lift; the
+    # missing piece is telling the block-level SETcc/Jcc tracker that those
+    # instructions, too, are the most recent flag producer.
+    for mnemonic in ("cmpsb", "cmpsw", "cmpsd", "scasb", "scasw", "scasd"):
+        assert mnemonic in patched
+    assert 'for name in _REPE_COMPARE_FLAG_MNEMONICS' in patched
+    assert 'name in raw_m' in patched
+    assert 'name in rest' in patched
+
+    # Applying the toolkit correction twice must not mutate the file again.
+    once = patched
+    patch_xboxrecomp_repeated_string_compare_flags(toolkit)
+    assert lifter.read_text(encoding="utf-8") == once
+
+
+def test_v24_pipeline_applies_wide_string_flag_patch_before_disassembly():
+    source = (root() / "scripts" / "jsrf_xboxrecomp.py").read_text(encoding="utf-8")
+    run_pipeline = source[source.index("def run_pipeline("):]
+    patch_call = "patch_xboxrecomp_repeated_string_compare_flags(toolkit_dir)"
+    commands = "commands = build_pipeline_commands"
+    assert patch_call in run_pipeline
+    assert run_pipeline.index(patch_call) < run_pipeline.index(commands)
