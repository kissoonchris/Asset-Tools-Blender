+class JSRFApuRuntimeTests(unittest.TestCase):
+    def test_v21_enables_upstream_ac97_apu_path_before_memory_layout(self):
+        root = Path(__file__).resolve().parents[1]
+        main_c = (root / "recomp" / "src" / "main.c").read_text(encoding="utf-8")
+        enable = 'SetEnvironmentVariableA("RECOMP_AC97_READY", "1")'
+        init = "xbox_MemoryLayoutInit(xbe_data, xbe_size)"
+        self.assertIn(enable, main_c)
+        self.assertIn(init, main_c)
+        self.assertLess(main_c.index(enable), main_c.index(init))
+
+    def test_v21_initializes_and_owns_upstream_mcpx_apu(self):
+        root = Path(__file__).resolve().parents[1]
+        main_c = (root / "recomp" / "src" / "main.c").read_text(encoding="utf-8")
+        self.assertIn("mcpx_apu_init_standalone", main_c)
+        self.assertIn("g_apu_state = jsrf_apu", main_c)
+        self.assertIn("mcpx_apu_shutdown(jsrf_apu)", main_c)
+        self.assertIn("g_apu_state = NULL", main_c)
+        self.assertLess(main_c.index("mcpx_apu_init_standalone"), main_c.index("xbe_entry_point();"))
+
+    def test_v21_routes_only_apu_mmio_faults_to_upstream_veh_decoder(self):
+        root = Path(__file__).resolve().parents[1]
+        main_c = (root / "recomp" / "src" / "main.c").read_text(encoding="utf-8")
+        self.assertIn("apu_hook_handle_mmio", main_c)
+        self.assertIn("0xFE800000u", main_c)
+        self.assertIn("0xFE880000u", main_c)
+        self.assertIn("EXCEPTION_CONTINUE_EXECUTION", main_c)
+        # Crash diagnostics must remain as the fallback for non-APU faults.
+        self.assertIn("[CRASH]", main_c)
+        self.assertIn("EXCEPTION_CONTINUE_SEARCH", main_c)
+
+    def test_v21_enables_bounded_upstream_apu_trace_for_next_windows_run(self):
+        root = Path(__file__).resolve().parents[1]
+        main_c = (root / "recomp" / "src" / "main.c").read_text(encoding="utf-8")
+        self.assertIn('SetEnvironmentVariableA("RECOMP_APU_TRACE", "1")', main_c)
+
+
