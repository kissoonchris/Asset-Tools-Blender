+/*
+ * ABI-check callback required when the generated JSRF sources are compiled
+ * with RECOMP_ABI_CHECK.  The pinned xboxrecomp headers emit calls to this
+ * symbol from generated objects; define it in the host executable so the
+ * diagnostic build cannot fail at link time.
+ */
+void recomp_abi_violation_log(uint32_t va, uint32_t ebx0, uint32_t esi0,
+                              uint32_t edi0, uint32_t esp0)
+{
+    enum { SLOT_COUNT = 32 };
+    static uint32_t seen[SLOT_COUNT];
+    static uint64_t hits[SLOT_COUNT];
+    static int count;
+    int i;
+
+    for (i = 0; i < count; ++i) {
+        if (seen[i] == va) {
+            break;
+        }
+    }
+    if (i == count) {
+        if (count == SLOT_COUNT) {
+            return;
+        }
+        seen[count] = va;
+        hits[count] = 0;
+        ++count;
+    }
+
+    ++hits[i];
+    {
+        uint64_t n = hits[i];
+        while (n >= 10 && n % 10 == 0) {
+            n /= 10;
+        }
+        if (n != 1) {
+            return;
+        }
+    }
+
+    fprintf(stderr,
+            "[ABI] target 0x%08X violation #%llu: "
+            "ebx %08X->%08X esi %08X->%08X edi %08X->%08X "
+            "esp %08X->%08X\n",
+            va, (unsigned long long)hits[i],
+            ebx0, g_ebx, esi0, g_esi, edi0, g_edi, esp0, g_esp);
+    fflush(stderr);
+}
