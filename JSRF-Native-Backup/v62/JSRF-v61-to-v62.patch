+def patch_xboxrecomp_merged_cmp_flag_state(toolkit_dir: str | Path) -> None:
+    """Preserve runtime CMP/TEST snapshots across compatible CFG merges.
+
+    The pinned translator carries flag provenance as a Python tuple describing
+    the static instruction that last set EFLAGS.  At a basic-block merge it
+    currently requires every predecessor tuple to be *identical*.  That is too
+    strict for ordinary x86 control flow: two predecessors can each execute a
+    different 32-bit CMP and then join at one Jcc.  The generated function has
+    already emitted the runtime `_fa/_fb/_fas/_fbs` snapshot for whichever CMP
+    actually executed, but the translator discards the provenance at the join
+    and falls back to `_flags`, which is initialized to zero and is not an x86
+    EFLAGS register.
+
+    JSRF's retail ADXT watchdog is exactly this shape at 0x0013D3F3: state 3
+    reaches the shared JLE after `cmp eax, edx`; the other states reach it after
+    `cmp edx, ecx`.  v61 measured edx=1 and ecx=1200 immediately before that
+    JLE, yet the branch was not taken and retail error -1 was written.
+
+    Merge only CMP/TEST states of the same operand width.  The representative
+    static operands are used only to tell `_make_condition` the setter kind and
+    width; the condition itself reads the runtime snapshot left by the taken
+    predecessor.  Incompatible setters or widths retain the old conservative
+    `incoming = None` behavior.
+    """
+    import re
+
+    toolkit_dir = Path(toolkit_dir)
+    path = toolkit_dir / "tools" / "recomp" / "translator.py"
+    if not path.is_file():
+        raise FileNotFoundError(f"xboxrecomp translator was not found: {path}")
+
+    text = path.read_text(encoding="utf-8")
+    marker = "# JSRF v62: merge compatible runtime cmp/test snapshots"
+    if marker in text:
+        return
+
+    pattern = re.compile(
+        r'(?m)^(?P<i>\s*)elif all\(p in out_state for p in sources\):\n'
+        r'(?P=i)    states = \[out_state\[p\] for p in sources\]\n'
+        r'(?P=i)    incoming = states\[0\]\n'
+        r'(?P=i)    for other in states\[1:\]:\n'
+        r'(?P=i)        if other != incoming:\n'
+        r'(?P=i)            incoming = None\n'
+        r'(?P=i)            break\n'
+    )
+    match = pattern.search(text)
+    if not match:
+        raise RuntimeError(
+            "Pinned xboxrecomp flag-state merge no longer matches translator.py"
+        )
+
+    i = match.group("i")
+    replacement = (
+        i + "elif all(p in out_state for p in sources):\n"
+        + i + "    states = [out_state[p] for p in sources]\n"
+        + i + "    incoming = states[0]\n"
+        + i + "    if any(other != incoming for other in states[1:]):\n"
+        + i + "        " + marker + "\n"
+        + i + "        _snapshot_keys = []\n"
+        + i + "        for state in states:\n"
+        + i + "            if (not state or state[0] not in (\"cmp\", \"test\")\n"
+        + i + "                    or len(state[1]) < 2):\n"
+        + i + "                _snapshot_keys = []\n"
+        + i + "                break\n"
+        + i + "            _width = None\n"
+        + i + "            for _op in state[1][:2]:\n"
+        + i + "                if getattr(_op, \"type\", None) == \"mem\":\n"
+        + i + "                    _width = getattr(_op, \"mem_size\", None) or 4\n"
+        + i + "                    break\n"
+        + i + "                if getattr(_op, \"type\", None) == \"reg\":\n"
+        + i + "                    _reg = str(getattr(_op, \"reg\", \"\") or \"\").lower()\n"
+        + i + "                    if _reg in (\"al\", \"ah\", \"bl\", \"bh\", \"cl\", \"ch\", \"dl\", \"dh\"):\n"
+        + i + "                        _width = 1\n"
+        + i + "                    elif _reg in (\"ax\", \"bx\", \"cx\", \"dx\", \"si\", \"di\", \"bp\", \"sp\"):\n"
+        + i + "                        _width = 2\n"
+        + i + "                    else:\n"
+        + i + "                        _width = 4\n"
+        + i + "                    break\n"
+        + i + "            _snapshot_keys.append((state[0], _width or 4))\n"
+        + i + "        if (_snapshot_keys\n"
+        + i + "                and len(set(_snapshot_keys)) == 1):\n"
+        + i + "            incoming = states[0]  # runtime _fa/_fb contain the taken predecessor\n"
+        + i + "        else:\n"
+        + i + "            incoming = None\n"
+    )
+
+    text = text[:match.start()] + replacement + text[match.end():]
+    path.write_text(text, encoding="utf-8")
+
