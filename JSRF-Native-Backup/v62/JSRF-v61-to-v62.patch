+from pathlib import Path
+
+
+def _write_pinned_translator_fixture(path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        '''# pinned xboxrecomp translator merge fragment\n'''
+        '''def translate(blocks, preds, out_state):\n'''
+        '''    results = []\n'''
+        '''    for bb in blocks:\n'''
+        '''        sources = preds[bb.start]\n'''
+        '''        if bb.start == 0 or not sources:\n'''
+        '''            incoming = None\n'''
+        '''        elif all(p in out_state for p in sources):\n'''
+        '''            states = [out_state[p] for p in sources]\n'''
+        '''            incoming = states[0]\n'''
+        '''            for other in states[1:]:\n'''
+        '''                if other != incoming:\n'''
+        '''                    incoming = None\n'''
+        '''                    break\n'''
+        '''        else:\n'''
+        '''            incoming = None\n'''
+        '''        results.append(incoming)\n'''
+        '''    return results\n''',
+        encoding='utf-8',
+    )
+
+
+def test_v62_patches_differing_same_width_cmp_predecessors(tmp_path):
+    from scripts.jsrf_xboxrecomp import patch_xboxrecomp_merged_cmp_flag_state
+
+    translator = tmp_path / 'tools' / 'recomp' / 'translator.py'
+    _write_pinned_translator_fixture(translator)
+
+    patch_xboxrecomp_merged_cmp_flag_state(tmp_path)
+    text = translator.read_text(encoding='utf-8')
+
+    assert 'JSRF v62: merge compatible runtime cmp/test snapshots' in text
+    assert 'state[0] not in ("cmp", "test")' in text
+    assert 'len(set(_snapshot_keys)) == 1' in text
+    assert 'incoming = states[0]  # runtime _fa/_fb contain the taken predecessor' in text
+
+
+def test_v62_patch_is_idempotent(tmp_path):
+    from scripts.jsrf_xboxrecomp import patch_xboxrecomp_merged_cmp_flag_state
+
+    translator = tmp_path / 'tools' / 'recomp' / 'translator.py'
+    _write_pinned_translator_fixture(translator)
+    patch_xboxrecomp_merged_cmp_flag_state(tmp_path)
+    once = translator.read_text(encoding='utf-8')
+    patch_xboxrecomp_merged_cmp_flag_state(tmp_path)
+    twice = translator.read_text(encoding='utf-8')
+    assert twice == once
+
+
+
+def test_v62_patched_merge_uses_runtime_snapshot_only_for_compatible_states(tmp_path):
+    from types import SimpleNamespace
+    from scripts.jsrf_xboxrecomp import patch_xboxrecomp_merged_cmp_flag_state
+
+    translator = tmp_path / "tools" / "recomp" / "translator.py"
+    _write_pinned_translator_fixture(translator)
+    patch_xboxrecomp_merged_cmp_flag_state(tmp_path)
+
+    ns = {}
+    exec(compile(translator.read_text(encoding="utf-8"), str(translator), "exec"), ns)
+    bb = SimpleNamespace(start=1)
+    r32a = SimpleNamespace(type="reg", reg="eax")
+    r32b = SimpleNamespace(type="reg", reg="edx")
+    r32c = SimpleNamespace(type="reg", reg="ecx")
+    r16 = SimpleNamespace(type="reg", reg="ax")
+
+    merged = ns["translate"](
+        [bb], {1: {10, 20}},
+        {10: ("cmp", [r32a, r32b]), 20: ("cmp", [r32b, r32c])},
+    )[0]
+    assert merged is not None and merged[0] == "cmp"
+
+    mixed_width = ns["translate"](
+        [bb], {1: {10, 20}},
+        {10: ("cmp", [r32a, r32b]), 20: ("cmp", [r16, r16])},
+    )[0]
+    assert mixed_width is None
+
+    mixed_setter = ns["translate"](
+        [bb], {1: {10, 20}},
+        {10: ("cmp", [r32a, r32b]), 20: ("test", [r32b, r32c])},
+    )[0]
+    assert mixed_setter is None
+
+
+def test_v62_pipeline_applies_flag_merge_patch_before_recompilation():
+    import inspect
+    from scripts import jsrf_xboxrecomp
+
+    src = inspect.getsource(jsrf_xboxrecomp.run_pipeline)
+    assert 'patch_xboxrecomp_merged_cmp_flag_state(toolkit_dir)' in src
+    assert src.index('patch_xboxrecomp_merged_cmp_flag_state(toolkit_dir)') < src.index('commands = build_pipeline_commands')
+
+
+def test_v62_banner_is_current():
+    root = Path(__file__).resolve().parents[1]
+    main_c = (root / 'recomp' / 'src' / 'main.c').read_text(encoding='utf-8')
+    assert 'JSRF Native v62' in main_c
