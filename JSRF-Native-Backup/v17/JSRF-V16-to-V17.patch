+class JSRFLockXaddFlagPatchTests(unittest.TestCase):
+    def test_patches_pinned_xboxrecomp_lock_xadd_flag_tracking(self):
+        import scripts.jsrf_xboxrecomp as driver
+        patch = getattr(driver, "patch_xboxrecomp_lock_xadd_flags", None)
+        self.assertIsNotNone(
+            patch,
+            "JSRF must correct pinned xboxrecomp's lock-xadd flag tracking before generation",
+        )
+        lifter = r'''
+_EFLAGS_SETTERS = frozenset({
+    "cmpxchg",
+    "xadd",              # Exchange-and-add sets flags
+})
+_FLAGS_UNDEFINED = frozenset({
+    "mul",
+    "lock xadd",           # Lock prefix - complex flag behavior
+})
+
+def _make_jcc_condition(jcc, flag_setter, lhs, desc):
+    if flag_setter == "xadd":
+        if jcc in ("jne", "jnz"):
+            return f"({lhs} != 0)", desc
+'''
+        with tempfile.TemporaryDirectory() as td:
+            toolkit = Path(td)
+            path = toolkit / "tools" / "recomp" / "lifter.py"
+            path.parent.mkdir(parents=True)
+            path.write_text(lifter, encoding="utf-8")
+            patch(toolkit)
+            once = path.read_text(encoding="utf-8")
+            patch(toolkit)
+            twice = path.read_text(encoding="utf-8")
+
+        self.assertEqual(once, twice, "toolkit flag patch must be idempotent")
+        self.assertIn('"xadd", "lock xadd",', once)
+        self.assertNotIn('"lock xadd",           # Lock prefix - complex flag behavior', once)
+        self.assertIn('if flag_setter in ("xadd", "lock xadd"):', once)
+
+    def test_pipeline_applies_lock_xadd_flag_patch_before_recompilation(self):
+        import inspect
+        import scripts.jsrf_xboxrecomp as driver
+        source = inspect.getsource(driver.run_pipeline)
+        self.assertIn("patch_xboxrecomp_lock_xadd_flags(toolkit_dir)", source)
+        self.assertLess(
+            source.index("patch_xboxrecomp_lock_xadd_flags(toolkit_dir)"),
+            source.index("commands = build_pipeline_commands"),
+        )
+
+
