+def patch_xboxrecomp_lock_xadd_flags(toolkit_dir: str | Path) -> None:
+    """Restore x86 EFLAGS tracking for lock-prefixed XADD in the pinned toolkit.
+
+    xboxrecomp already lowers both XADD forms through the same atomic primitive,
+    but the pinned lifter classifies ``lock xadd`` as flag-undefined.  A JCC
+    immediately after InterlockedDecrement therefore reads no XADD result.  JSRF
+    uses exactly that MSVC pattern for COM Release methods (for example retail
+    0x0015FD40), so a nonzero reference count can incorrectly take the zero path
+    and destroy a live object.
+
+    Keep the atomic lowering untouched; only make the flag tracker treat the
+    lock-prefixed spelling exactly like the existing xadd condition path.
+    """
+    import re
+
+    toolkit_dir = Path(toolkit_dir)
+    path = toolkit_dir / "tools" / "recomp" / "lifter.py"
+    if not path.is_file():
+        raise FileNotFoundError(f"xboxrecomp lifter was not found: {path}")
+
+    text = path.read_text(encoding="utf-8")
+    if (
+        '"xadd", "lock xadd",' in text
+        and 'if flag_setter in ("xadd", "lock xadd"):' in text
+        and not re.search(r'^\s*"lock xadd",\s*# Lock prefix - complex flag behavior\s*$', text, re.M)
+    ):
+        return
+
+    setter_pattern = re.compile(
+        r'(?m)^(?P<indent>\s*)"xadd",(?P<spacing>\s*)# Exchange-and-add sets flags\s*$'
+    )
+    text, setter_count = setter_pattern.subn(
+        r'\g<indent>"xadd", "lock xadd",\g<spacing># Exchange-and-add sets flags',
+        text,
+        count=1,
+    )
+
+    undefined_pattern = re.compile(
+        r'(?m)^\s*"lock xadd",\s*# Lock prefix - complex flag behavior\s*\n?'
+    )
+    text, undefined_count = undefined_pattern.subn("", text, count=1)
+
+    condition_old = 'if flag_setter == "xadd":'
+    condition_new = 'if flag_setter in ("xadd", "lock xadd"):'
+    condition_count = text.count(condition_old)
+    if condition_count == 1:
+        text = text.replace(condition_old, condition_new, 1)
+    elif condition_new in text:
+        condition_count = 1
+    else:
+        condition_count = 0
+
+    if setter_count != 1 or undefined_count != 1 or condition_count != 1:
+        raise RuntimeError(
+            "Pinned xboxrecomp lock-xadd flag patch no longer matches lifter.py "
+            f"(setter={setter_count}, undefined={undefined_count}, condition={condition_count})"
+        )
+
+    path.write_text(text, encoding="utf-8")
+
+
