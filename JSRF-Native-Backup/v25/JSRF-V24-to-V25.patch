diff -ruN patch_v24/tests/test_v25_xfile_vtable_boundary.py patch_v25/tests/test_v25_xfile_vtable_boundary.py
--- patch_v24/tests/test_v25_xfile_vtable_boundary.py	1970-01-01 00:00:00.000000000 +0000
+++ patch_v25/tests/test_v25_xfile_vtable_boundary.py	2026-09-07 17:13:20.451715455 +0000
@@ -0,0 +1,37 @@
+import json
+from pathlib import Path
+
+
+def root() -> Path:
+    return Path(__file__).resolve().parents[1]
+
+
+def test_v25_seeds_retail_indirect_method_00178f40():
+    seeds = json.loads((root() / 'recomp' / 'jsrf_runtime_seeds.json').read_text(encoding='utf-8'))
+    starts = {int(item['start'], 16) for item in seeds}
+    assert 0x00178F40 in starts
+
+
+def test_v25_pins_retail_indirect_method_boundary(tmp_path):
+    from scripts.jsrf_xboxrecomp import pin_jsrf_function_boundaries
+
+    path = tmp_path / 'functions.json'
+    path.write_text(json.dumps([{
+        'start': '0x00178E70',
+        'end': '0x00179210',
+        'size': 0x3A0,
+        'name': 'sub_00178E70',
+        'section': '.text',
+        'confidence': 0.7,
+        'detection_method': 'generic',
+        'num_instructions': 1,
+        'has_prologue': False,
+        'calls_to': [],
+        'called_by': [],
+    }]), encoding='utf-8')
+
+    pin_jsrf_function_boundaries(path)
+    funcs = {int(f['start'], 16): f for f in json.loads(path.read_text(encoding='utf-8'))}
+    assert int(funcs[0x00178F40]['end'], 16) == 0x001791BB
+    assert funcs[0x00178F40]['detection_method'] == 'jsrf_retail_boundary'
+    assert '0x00176f70' in funcs[0x00178F40]['called_by']
