+    src.write_text(text, encoding="utf-8")
+
+    instrument_jsrf_adxt_ring_probe(tmp_path)
+    once = src.read_text(encoding="utf-8")
+
+    assert "void sub_0013FAD0(void)\n{\n    jsrf_adxt_ring_probe(0x0013FAD0u);" in once
+    instrument_jsrf_adxt_ring_probe(tmp_path)
