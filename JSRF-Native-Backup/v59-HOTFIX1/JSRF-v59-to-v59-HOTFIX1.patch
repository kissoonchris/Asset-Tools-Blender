--- jsrf_v59_src/scripts/jsrf_xboxrecomp.py	2026-09-10 20:43:10.667232729 +0000
+++ jsrf_v59_hotfix1/scripts/jsrf_xboxrecomp.py	2026-09-10 21:20:38.539458069 +0000
@@ -2998,6 +2998,22 @@
             if count:
                 remaining.discard(va)
                 changed = True
+                continue
+
+            # xboxrecomp does not guarantee that a translated function start is
+            # also emitted as a loc_XXXXXXXX label.  In the retail JSRF build,
+            # 0x0013FAD0 is a real function entry but its redundant entry label
+            # is omitted, so anchor the probe directly after the function's
+            # opening brace when the label form is absent.
+            func_pattern = re.compile(
+                rf"(?m)^(?P<sig>void\s+sub_{va:08X}\(void\)\s*\n\{{)$"
+            )
+            text, count = func_pattern.subn(
+                rf"\g<sig>\n    {call}", text, count=1
+            )
+            if count:
+                remaining.discard(va)
+                changed = True
         if changed:
             texts[source] = text
 
