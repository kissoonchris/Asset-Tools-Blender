diff --git a/tests/test_v23_dsound_interface_boundaries.py b/tests/test_v23_dsound_interface_boundaries.py
new file mode 100644
index 0000000..f6e107f
--- /dev/null
+++ b/tests/test_v23_dsound_interface_boundaries.py
@@ -0,0 +1,50 @@
+import json
+from pathlib import Path
+
+
+def root() -> Path:
+    return Path(__file__).resolve().parents[1]
+
+
+def test_v23_seeds_and_traces_retail_dsound_interface_methods():
+    seeds = json.loads((root() / "recomp" / "jsrf_runtime_seeds.json").read_text(encoding="utf-8"))
+    starts = {int(item["start"], 16) for item in seeds}
+    required = {0x00168310, 0x00168400, 0x00168480}
+    assert required.issubset(starts)
+
+    trace = json.loads((root() / "recomp" / "jsrf_trace_functions.json").read_text(encoding="utf-8"))
+    traced = {int(value, 16) if isinstance(value, str) else int(value) for value in trace}
+    assert required.issubset(traced)
+
+
+def test_v23_pins_padding_delimited_dsound_vtable_boundaries(tmp_path):
+    from scripts.jsrf_xboxrecomp import pin_jsrf_function_boundaries
+
+    # Model the generic detector swallowing the three vtable-only entries into
+    # a surrounding body. Retail disassembly proves each is an independent
+    # padding-delimited method. The JSRF post-pass must restore all three.
+    path = tmp_path / "functions.json"
+    path.write_text(json.dumps([
+        {
+            "start": "0x00168260",
+            "end": "0x00168500",
+            "size": 0x2A0,
+            "name": "sub_00168260",
+            "section": ".text",
+            "confidence": 0.7,
+            "detection_method": "generic",
+            "num_instructions": 1,
+            "has_prologue": False,
+            "calls_to": [],
+            "called_by": [],
+        }
+    ]), encoding="utf-8")
+
+    pin_jsrf_function_boundaries(path)
+    funcs = {int(f["start"], 16): f for f in json.loads(path.read_text(encoding="utf-8"))}
+    assert int(funcs[0x00168310]["end"], 16) == 0x001683F9
+    assert int(funcs[0x00168400]["end"], 16) == 0x00168473
+    assert int(funcs[0x00168480]["end"], 16) == 0x001684DF
+    assert funcs[0x00168310]["detection_method"] == "jsrf_retail_boundary"
+    assert funcs[0x00168400]["detection_method"] == "jsrf_retail_boundary"
+    assert funcs[0x00168480]["detection_method"] == "jsrf_retail_boundary"
