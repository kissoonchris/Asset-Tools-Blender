+static int jsrf_guest_read_u32(uint32_t va, uint32_t *value)
+{
+    if (!value || !g_xbox_mem_offset || va < 0x00001000u || va > 0x03FFFFFCu) {
+        return 0;
+    }
+    *value = GUEST_U32(va);
+    return 1;
+}
+
+static int jsrf_guest_read_u16(uint32_t va, uint16_t *value)
+{
+    if (!value || !g_xbox_mem_offset || va < 0x00001000u || va > 0x03FFFFFEu) {
+        return 0;
+    }
+    *value = *(const uint16_t *)((uintptr_t)g_xbox_mem_offset + va);
+    return 1;
+}
+
+/*
+ * v16 diagnostic probe for retail heap allocator 0x001497DC.
+ *
+ * The v15 watchdog snapshot ended after a successful EnterCriticalSection with
+ * registers matching one of the allocator's sorted large-free-list walks.
+ * Function-level tracing cannot distinguish those near-identical loops.  The
+ * generated source therefore calls this observer only at seven retail branch
+ * targets.  It never writes a guest register or guest memory.
+ *
+ * Each site prints the first four visits, then powers of two.  A self-linked
+ * or short-cycle free-list therefore becomes obvious without filling the log.
+ */
+void jsrf_heap_probe(uint32_t va)
+{
+    enum { SLOT_COUNT = 16 };
+    static uint32_t sites[SLOT_COUNT];
+    static uint64_t hits[SLOT_COUNT];
+    static int count;
+    uint32_t sentinel = 0;
+    uint32_t sentinel_next = 0;
+    uint32_t sentinel_prev = 0;
+    uint32_t node_next = 0;
+    uint32_t node_prev = 0;
+    uint16_t node_units = 0;
+    int have_sentinel = 0;
+    int have_node = 0;
+    int i;
+
+    for (i = 0; i < count; ++i) {
+        if (sites[i] == va) {
+            break;
+        }
+    }
+    if (i == count) {
+        if (count == SLOT_COUNT) {
+            return;
+        }
+        sites[count] = va;
+        hits[count] = 0;
+        ++count;
+    }
+
+    ++hits[i];
+    if (hits[i] > 4 && (hits[i] & (hits[i] - 1)) != 0) {
+        return;
+    }
+
+    if (g_ebx <= 0x03FFFE7Fu) {
+        sentinel = g_ebx + 0x180u;
+        have_sentinel =
+            jsrf_guest_read_u32(sentinel, &sentinel_next) &&
+            jsrf_guest_read_u32(sentinel + 4u, &sentinel_prev);
+    }
+    if (g_eax >= 0x00001008u && g_eax <= 0x03FFFFF8u) {
+        have_node =
+            jsrf_guest_read_u32(g_eax, &node_next) &&
+            jsrf_guest_read_u32(g_eax + 4u, &node_prev) &&
+            jsrf_guest_read_u16(g_eax - 8u, &node_units);
+    }
+
+    fprintf(stderr,
+            "[HEAPPROBE] va=%08X hit=%llu esp=%08X eax=%08X ecx=%08X "
+            "edx=%08X ebx=%08X esi=%08X edi=%08X",
+            va, (unsigned long long)hits[i], g_esp, g_eax, g_ecx,
+            g_edx, g_ebx, g_esi, g_edi);
+    if (have_node) {
+        fprintf(stderr,
+                " node=%08X node_next=%08X node_prev=%08X units=%u",
+                g_eax, node_next, node_prev, (unsigned)node_units);
+    }
+    if (have_sentinel) {
+        fprintf(stderr,
+                " sentinel=%08X sentinel_next=%08X sentinel_prev=%08X",
+                sentinel, sentinel_next, sentinel_prev);
+    }
+    fputc('\n', stderr);
+    fflush(stderr);
+}
