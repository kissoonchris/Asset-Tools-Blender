+def instrument_jsrf_heap_allocator_probe(gen_dir: str | Path) -> None:
+    """Inject diagnostic-only probes at retail heap allocator loop landmarks.
+
+    The v15 watchdog registers match the large free-list walk in 0x001497DC,
+    but function-entry tracing cannot identify which of the three equivalent
+    walks is spinning.  Insert calls only at measured branch-target labels in
+    that generated retail function.  The callback reads/logs guest state but
+    does not modify any guest register or memory.
+    """
+    import re
+
+    gen_dir = Path(gen_dir)
+    signature = "void sub_001497DC(void)"
+    declaration = "extern void jsrf_heap_probe(uint32_t va);"
+    found_function = False
+    injected = set()
+
+    for source in sorted(gen_dir.glob("recomp_*.c")):
+        text = source.read_text(encoding="utf-8", errors="replace")
+        start = text.find(signature)
+        if start < 0:
+            continue
+        found_function = True
+        next_function = text.find("\n/**", start + len(signature))
+        end = len(text) if next_function < 0 else next_function
+        body = text[start:end]
+
+        if "jsrf_heap_probe(" in body:
+            # A previously instrumented generation is already complete.
+            return
+
+        for va in JSRF_HEAP_PROBE_VAS:
+            label_re = re.compile(
+                rf"(?mi)^(?P<label>loc_{va:08X}:\s*;?\s*)$"
+            )
+            replacement = (
+                rf"\g<label>\n    jsrf_heap_probe(0x{va:08X}u);"
+            )
+            body, count = label_re.subn(replacement, body, count=1)
+            if count:
+                injected.add(va)
+
+        missing = set(JSRF_HEAP_PROBE_VAS) - injected
+        if missing:
+            rendered = ", ".join(f"0x{va:08X}" for va in sorted(missing))
+            raise RuntimeError(
+                "Generated sub_001497DC is missing retail heap probe label(s): "
+                + rendered
+            )
+
+        if declaration not in text[:start]:
+            body = declaration + "\n" + body
+        text = text[:start] + body + text[end:]
+        source.write_text(text, encoding="utf-8")
+        return
+
+    if not found_function:
+        raise RuntimeError("Generated sub_001497DC was not found for v16 heap probing")
+
+
