+    # If DbgHelp named an exact generated C source line, preserve the nearby
+    # lifted statements automatically.  This turns the next crash report into
+    # a source-level diagnosis without asking the user to find generated files.
+    if (Test-Path -LiteralPath $RuntimeLog -PathType Leaf) {
+        $RuntimeText = Get-Content -LiteralPath $RuntimeLog -Raw
+        $SourceMatches = [regex]::Matches(
+            $RuntimeText,
+            'source (?<path>[A-Za-z]:\\[^\r\n]+?\.c):(?<line>\d+)'
+        )
+        $SeenSource = @{}
+        foreach ($SourceMatch in $SourceMatches) {
+            $SourcePath = $SourceMatch.Groups['path'].Value
+            $SourceLine = [int]$SourceMatch.Groups['line'].Value
+            $SourceKey = $SourcePath + ':' + $SourceLine
+            if ($SeenSource.ContainsKey($SourceKey)) { continue }
+            $SeenSource[$SourceKey] = $true
+            if (-not (Test-Path -LiteralPath $SourcePath -PathType Leaf)) { continue }
+
+            $SourceLines = @(Get-Content -LiteralPath $SourcePath)
+            $FirstLine = [Math]::Max(1, $SourceLine - 24)
+            $LastLine = [Math]::Min($SourceLines.Count, $SourceLine + 24)
+            Add-Content -LiteralPath $SourceContextLog -Value '================ SOURCE CONTEXT ================'
+            Add-Content -LiteralPath $SourceContextLog -Value (
+                $SourcePath + ':' + $SourceLine + '  lines ' + $FirstLine + '-' + $LastLine
+            )
+            for ($LineNumber = $FirstLine; $LineNumber -le $LastLine; $LineNumber++) {
+                $Marker = if ($LineNumber -eq $SourceLine) { '>>' } else { '  ' }
+                Add-Content -LiteralPath $SourceContextLog -Value (
+                    ('{0} {1,7}: {2}' -f $Marker, $LineNumber, $SourceLines[$LineNumber - 1])
+                )
+            }
+            Add-Content -LiteralPath $SourceContextLog -Value ''
+        }
+    }
+
     if ($RunExitCode -eq 3) {
         Write-Host "Native runtime hit the xboxrecomp watchdog diagnostic exit (code 3)."
     } else {
